{
  "name": "@meridian/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./__test-support__/db-fixtures": "./src/__test-support__/db-fixtures.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "tsx ../../tools/dev/generate-baseline.ts",
    "db:migrate": "tsx ../../tools/dev/migrate-db.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@meridian/contracts": "workspace:*",
    "@meridian/prosemirror-schema": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
