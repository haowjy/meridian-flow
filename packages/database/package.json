{
  "name": "@meridian/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./release": "./src/release-runner.ts",
    "./__test-support__/db-fixtures": "./src/__test-support__/db-fixtures.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./schema/sql/*": "./src/schema/sql/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ../../tools/dev/migrate-db.ts",
    "db:studio": "drizzle-kit studio",
    "db:apply-functions": "tsx scripts/apply-functions.ts",
    "build:release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "@meridian/contracts": "workspace:*",
    "@meridian/prosemirror-schema": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "esbuild": "0.28.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
