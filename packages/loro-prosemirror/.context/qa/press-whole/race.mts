import * as H from "./probe.mts";
const { setup, posOf, show, report, cmds, dm } = H;
const s = setup(["alpha beta gamma", "delta"]);
const server = s.draft;
const tab = server.fork("31");
const sync = (from, to) => {
  if (from.live && to.live) to.live.importBatch(from.live.exportSince(to.live.version()));
  to.importBatch(from.exportSince(to.version()));
};
H.edit(tab, (st) => H.cmd(cmds.splitBlock, posOf(st.doc, "P0", 6))(st));
sync(tab, server);
server.forward();
report("server after tab's split", s);
const cmdCopy = server.fork("41");
dm.applyBlocks(cmdCopy, ["P0"], { liveVersion: s.live.version() });
sync(cmdCopy, server); server.forward();
report("server after press", s);
let n; H.read(tab).descendants((x) => { if (x.isTextblock && x.attrs.id !== "P0" && x.attrs.id !== "P1") n = x.attrs.id; return true; });
H.edit(tab, (st) => H.cmd(cmds.joinBackward, posOf(st.doc, n))(st));
console.log("tab before merge:", show(tab), H.pieces(tab));
{ const m = tab.structure.getMap("d.order"); console.log("tab pre-merge d.order[N]=", JSON.stringify(m.get(n))); const t2 = tab.structure.fork(); t2.import(server.structure.export({mode:"update"})); console.log("raw merge d.order[N]=", JSON.stringify(t2.getMap("d.order").get(n)), "tab lamport-ish", tab.structure.getChangeAt ? "" : "", JSON.stringify(tab.structure.oplogVersion().toJSON()), JSON.stringify(server.structure.oplogVersion().toJSON())); }
sync(server, tab); sync(tab, server); tab.forward(); server.forward();
for (const [name, c] of [["server", server], ["tab", tab]]) console.log(name, "| live:", show(c.live), "| draft:", show(c), "| pieces:", JSON.stringify(H.pieces(c)), "| changes:", H.groups(c));
const c2 = server.fork("51");
dm.applyBlocks(c2, [n], { liveVersion: c2.live.version() });
console.log("Apply naming N on server: live:", show(c2.live), "| pending", H.groups(c2));
const dump = (c, label) => { const m = c.structure.getMap("d.order"); console.log(label, "d.order[N] =", JSON.stringify(m.get(n)), "| base order[N] =", JSON.stringify(c.structure.getMap("order").get(n))); };
dump(server, "server"); dump(tab, "tab");
const c3 = server.fork("71");
dm.applyBlocks(c3, ["P0"], { liveVersion: c3.live.version() });
console.log("Apply naming P0 on server: live:", show(c3.live), "| pending", H.groups(c3));
if (show(c3.live) !== "P0:alpha beta gamma | P1:delta") throw new Error("Apply naming P0 did not settle the race");
sync(c3, server);
server.forward();
sync(server, tab);
tab.forward();
if (show(server) !== "P0:alpha beta gamma | P1:delta") throw new Error("server draft kept duplicate race text");
if (show(tab) !== show(server)) throw new Error("tab disagreed with server after race Apply");
console.log("race settled on both copies:", show(server), show(tab));
