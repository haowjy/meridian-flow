# Copy to .env and set DATABASE_URL (see below). Start local Postgres with `pnpm dev:infra`.
# Production deployment variables and setup are documented in docs/deploy/README.md.

# Drizzle / postgres.js — local postgres:16 container on host port 54422
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/meridian
PGPASSWORD=postgres

# Structured server events mirror to LOG_DIR/YYYY-MM-DD.jsonl. `pnpm dev` pins
# LOG_DIR to the repo-root logs/events/ dir; set it here ONLY to redirect the
# mirror elsewhere, and use an absolute path (a relative one is ignored because
# each dev service runs in its own package cwd).
# LOG_DIR=/absolute/path/to/logs/events
# LOG_RETENTION_DAYS=14
# EVENT_PROVIDER=local

# --- Database test fixture ---
# Internal Meridian user id for DB-backed integration tests. Use a throwaway DB.
TEST_USER_ID=
# --- App/server origin ---
# Required for production SSR API requests; dev resolves paired portless route automatically.
MERIDIAN_API_ORIGIN=

# --- Model providers (local dev defaults to mock) ---
# Provider availability is registry-driven: a real API key enables that provider.
# Keys beginning with `dev-` are placeholders and keep the mock fallback.
# MODEL_PROVIDER=mock          # force in-process mock (deterministic e2e)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# --- WorkOS AuthKit (@meridian/app) — use Staging in the WorkOS dashboard (free for dev). ---
# Copy API key + Client ID from Staging → API Keys / AuthKit.
# Cookie password: openssl rand -base64 32
# In dev the app auto-resolves the redirect host from the request origin (portless
# *.localhost, Tailscale *.ts.net). WORKOS_REDIRECT_URI just sets the scheme — leave
# the default https://app.meridian.localhost value; do NOT duplicate this line per worktree.
# Production uses WORKOS_REDIRECT_URI literally. Register it in WorkOS → Redirects.
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://app.meridian.localhost/api/auth/callback

# Dev-only: when set (e.g. =1), the app auto-logs-in the WORKOS_DEV_LOGIN_* user via
# /api/auth/dev-login instead of showing the WorkOS SSO screen. NODE_ENV!=production only.
# Set in gitignored .env for local automation; never enable in production.
# WORKOS_DEV_AUTOLOGIN=1

# --- Production-only server environment (configure in Railway; do not uncomment for local dev) ---
# NODE_ENV=production               # Production mode for live deployment images.
# APP_ENV=production                # Runtime environment identity: dev, staging, or production.
# MERIDIAN_BACKENDS=live            # Select live object-storage backend policy.
# OBJECT_STORE_PROVIDER=s3          # Required live server object-store provider.
# API_REPLICA_COUNT=1               # Required: collaboration requires one API replica.
# S3_BUCKET=uploads                 # Railway uploads bucket name.
# S3_ENDPOINT=                      # S3-compatible service endpoint.
# S3_PUBLIC_ENDPOINT=               # Public base endpoint for object links.
# S3_REGION=                        # Bucket signing region.
# S3_ACCESS_KEY=                     # Bucket access key secret.
# S3_SECRET_KEY=                     # Bucket secret key.
# S3_FORCE_PATH_STYLE=true          # S3 path-style requests (defaults to true).
# S3_CREATE_BUCKET_IF_MISSING=       # Leave unset for a provisioned bucket.
# OBJECT_STORE_SIGNED_URL_TTL_SECONDS=900 # Signed object URL lifetime.
# Railway server service deploy.drainingSeconds=30 # Set in Railway service configuration.
# WORKOS_COOKIE_PASSWORD=            # At least 32 characters; separate per environment.
# WORKOS_REDIRECT_URI=https://<host>/api/auth/callback # Registered callback URL.
# ANTHROPIC_API_KEY=                 # Or one of the live model provider API keys below.
# OPENAI_API_KEY=                    # Live model provider key.
# DEEPSEEK_API_KEY=                  # Live model provider key.
# OPENROUTER_API_KEY=                # Live model provider key.
# STRIPE_SECRET_KEY=                 # Optional: enables Stripe billing integration.
# STRIPE_WEBHOOK_SECRET=             # Optional: Stripe webhook signing secret.
# STRIPE_PRICE_PLAN_FREE=            # Optional: Stripe price ID for free plan.
# STRIPE_PRICE_PLAN_STANDARD=        # Optional: Stripe price ID for standard plan.
# STRIPE_PRICE_PLAN_PREMIUM=         # Optional: Stripe price ID for premium plan.
