# Copy to .env and set DATABASE_URL (see below). Start local Postgres with `pnpm dev:infra`.

# Drizzle / postgres.js — local Postgres container (postgres:16 + pg_bigm) on host port 54422
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/meridian
PGPASSWORD=postgres

# Structured server events mirror to LOG_DIR/YYYY-MM-DD.jsonl. `pnpm dev` pins
# LOG_DIR to the repo-root logs/events/ dir; set it here ONLY to redirect the
# mirror elsewhere, and use an absolute path (a relative one is ignored because
# each dev service runs in its own package cwd).
# LOG_DIR=/absolute/path/to/logs/events
# LOG_RETENTION_DAYS=14
# EVENT_PROVIDER=local

# --- Database test fixture ---
# Internal Meridian user id for DB-backed integration tests. Use a throwaway DB.
TEST_USER_ID=
# --- App/server origin ---
# Required for production SSR API requests; dev resolves paired portless route automatically.
MERIDIAN_API_ORIGIN=

# --- Model providers (local dev defaults to mock) ---
# Provider availability is registry-driven: a real API key enables that provider.
# Keys use a FLOW_ prefix so agent CLIs (Claude Code, Codex, opencode, pi) launched from
# this shell never pick up the app's provider credentials as their own.
# Keys beginning with `dev-` are placeholders and keep the mock fallback.
# MODEL_PROVIDER=mock          # force in-process mock (deterministic e2e)
# MOCK_MODEL_RESPONSE='{"sample":"scene","chunkDelayMs":20}' # default; see docs/debugging.md
# MOCK_MODEL_RESPONSE='{"lorem":{"words":10000},"chunkSize":256,"chunkDelayMs":10}'
# FLOW_ANTHROPIC_API_KEY=
# FLOW_OPENAI_API_KEY=
# FLOW_DEEPSEEK_API_KEY=
# FLOW_GEMINI_API_KEY=
# COMPACTION_SUMMARIZER_MODEL=deepseek-flash
# Registered model ID. If its provider is disabled, summaries use the thread model.
# LIVE_TEST_MODEL=deepseek-flash
# Dev and staging only. Sends every model call (chats, subagents, summaries) to this
# registry model; the server refuses to start in production with it set
# (a staging deploy must set APP_ENV=staging).

# --- WorkOS AuthKit (@meridian/app) — needed only with DEV_AUTH_BYPASS off (see below). ---
# Use Staging in the WorkOS dashboard (free for dev).
# Copy API key + Client ID from Staging → API Keys / AuthKit.
# Cookie password: openssl rand -base64 32
# In dev the app auto-resolves the redirect host from the request origin (portless
# *.localhost, Tailscale *.ts.net). WORKOS_REDIRECT_URI just sets the scheme — leave
# the default https://app.meridian.localhost value; do NOT duplicate this line per worktree.
# Production uses WORKOS_REDIRECT_URI literally. Register it in WorkOS → Redirects.
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://app.meridian.localhost/api/auth/callback

# Local dev only: every request is the dev user, with no login screen and no WorkOS call,
# so the WORKOS_* keys above are needed only with this off (real hosted login).
# Refused unless NODE_ENV=development and APP_ENV is unset or dev; `pnpm dev --funnel`
# refuses it too. Set DEV_AUTH_BYPASS=0 (or remove it) to test real login.
DEV_AUTH_BYPASS=1
# The dev user's id (stored as users.external_id); its email is <id>@example.com.
# DEV_AUTH_USER_ID=test

# Debug paths (model-request capture, /api/debug/*, mock-model scripting for ./mf).
# Never on in production; elsewhere only when set. `pnpm dev` defaults it to 1.
# APP_DEBUG=1
