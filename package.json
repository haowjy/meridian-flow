{
  "name": "meridian",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "bootstrap": "bun tools/dev/bootstrap.ts",
    "changelog": "node tools/ci/build-changelog.mjs",
    "db:migrate": "pnpm --filter @meridian/database db:migrate",
    "db:generate": "pnpm --filter @meridian/database db:generate",
    "db:check-extensions": "bun tools/dev/check-pg-extensions.ts",
    "db:studio": "pnpm --filter @meridian/database db:studio",
    "dev": "bun tools/dev/dev-tmux.ts",
    "dev:production-client": "bun tools/dev/dev-tmux.ts --production-client",
    "dev:local": "bun tools/dev/dev-tmux.ts --no-tailscale",
    "dev:stop": "bun tools/dev/dev-tmux.ts --stop",
    "dev:restart": "bun tools/dev/dev-tmux.ts --restart --preserve-mode",
    "dev:infra": "bun tools/dev/dev-infra-up.ts",
    "dev:infra:upgrade": "docker compose -f tools/dev/docker-compose.yml up -d --wait",
    "dev:infra:down": "docker compose -f tools/dev/docker-compose.yml down -t 5",
    "db:reset": "bun tools/dev/reset-db.ts --yes",
    "lint": "biome check .",
    "format": "biome check .",
    "format:write": "biome check --write .",
    "typecheck": "node tools/ci/run-nx-target.mjs typecheck",
    "typecheck:staged": "node tools/ci/run-nx-target.mjs typecheck --staged",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm lint && pnpm check:debug-probes && pnpm check:negative-space && pnpm check:slop-lint && pnpm check:i18n && pnpm typecheck && pnpm test && pnpm check:graph && pnpm check:architecture && pnpm check:db && pnpm check:pr-body",
    "portless:trust": "portless trust",
    "portless:list": "portless list",
    "prepare": "lefthook install",
    "dev:tmux": "bun tools/dev/dev-tmux.ts",
    "dev:funnel": "bun tools/dev/dev-tmux.ts --funnel",
    "models:refresh": "tsx apps/server/scripts/models-refresh.ts",
    "check:graph": "node tools/ci/check-graph.mjs",
    "check:architecture": "node tools/architecture-map/check.mjs .context/system-architecture/map.config.mjs",
    "check:pr-body": "node tools/ci/check-pr-body.mjs",
    "check:db": "bun tools/dev/check-db-gate.ts",
    "check:negative-space": "bash tools/ci/check-negative-space.sh",
    "check:slop-lint": "node tools/ci/check-slop-lint.mjs",
    "check:i18n": "node tools/ci/check-i18n-catalogs.mjs",
    "check:debug-probes": "node tools/ci/check-debug-probes.mjs",
    "dev:db:ensure": "bun tools/dev/ensure-db.ts",
    "dev:db:prepare": "bun tools/dev/prepare-db.ts",
    "dev:db:drop": "bun tools/dev/drop-db.ts",
    "smoke:project-domain": "tsx tools/dev/smoke-project-domain.ts",
    "smoke:app-dev-transform": "bun tools/dev/smoke-app-dev-transform.ts",
    "smoke:prod-boot": "bun tools/dev/smoke-prod-boot.ts",
    "dev:gc-dbs": "bun tools/dev/gc-dbs.ts",
    "dev:stacks": "bun tools/dev/dev-stacks.ts",
    "dev:prune-worktrees": "bun tools/dev/prune-worktrees.ts",
    "test:db": "bun tools/dev/run-db-tests.ts",
    "test:probes": "bun tools/qa/run-db-probes.ts",
    "test:all": "bun tools/dev/run-db-tests.ts --all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@meridian/contracts": "workspace:*",
    "@meridian/database": "workspace:*",
    "@meridian/prosemirror-schema": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "@typescript/typescript6": "^6.0.2",
    "ajv": "^8.20.0",
    "drizzle-orm": "catalog:",
    "esbuild": "0.28.2",
    "lefthook": "^2.2.2",
    "nx": "^24.0.6",
    "portless": "^0.17.0",
    "postgres": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.23.0",
    "yjs": "13.6.33"
  }
}
