{
  "name": "@meridian/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit -p tsconfig.json",
    "start": "NODE_ENV=production node scripts/validate-start-env.mjs && NODE_ENV=production node .output/server/index.mjs",
    "preview": "vite preview",
    "profile:dev-stack": "tsx scripts/profile-dev-stack.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e:auth": "MODEL_PROVIDER=mock playwright test -c e2e/playwright.auth.config.ts",
    "test:e2e:chat-smoke": "playwright test -c e2e/playwright.chat-smoke.config.ts",
    "test:e2e:mobile-shell": "playwright test -c e2e/playwright.mobile-shell.config.ts",
    "verify:process-disclosure": "bun e2e/verify-process-disclosure.mts",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "bench:markdown": "tsc --noEmit -p bench/tsconfig.json && tsx bench/markdown.mts"
  },
