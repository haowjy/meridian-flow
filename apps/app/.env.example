# @meridian/app loads environment from the repo root via direnv (see ../../.envrc).
# `pnpm bootstrap` creates ../../.env from ../../.env.example.
# Keep app-specific notes here; root .env remains the source of truth.
# Production deployment contract: ../../docs/deploy/README.md
# Required for production SSR API requests:
#   MERIDIAN_API_ORIGIN=http://server.railway.internal:3000
# Production Railway variables (configure per staging/production; don't uncomment locally):
# NODE_ENV=production               # Production mode for live app image.
# APP_ENV=production                # Runtime environment identity: dev, staging, or production.
# WORKOS_API_KEY=                   # WorkOS AuthKit API key (secret).
# WORKOS_CLIENT_ID=                 # WorkOS AuthKit client id.
# WORKOS_COOKIE_PASSWORD=           # Sealed-session password, at least 32 characters.
# WORKOS_REDIRECT_URI=https://<host>/api/auth/callback # Register this exact URL in WorkOS.
# WORKOS_DEV_AUTOLOGIN=              # Do not enable in production.
# WORKOS_DEV_LOGIN_EMAIL=            # Development-only; must not be set in production.
# WORKOS_DEV_LOGIN_PASSWORD=         # Development-only; must not be set in production.
