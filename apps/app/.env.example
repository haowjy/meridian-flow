# @meridian/app gets its environment from `pnpm dev` (tools/dev/lib/dev-env.ts loads the
# main checkout's .env and this checkout's .env.local). Copy ../../.env.example to ../../.env.
# Keep app-specific notes here; root .env remains the source of truth.
#
# Required for production SSR API requests:
#   MERIDIAN_API_ORIGIN
