{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.output",
      "!logs",
      "!**/.nx",
      "!**/.mars",
      "!**/.meridian",
      "!**/.meridian-work",
      "!**/.codex-local",
      "!**/routeTree.gen.ts",
      "!apps/**/src/styles",
      "!packages/design-tokens/src/*.css",
      "!apps/app/.auth",
      "!apps/app/test-results",
      "!apps/app/playwright-report",
      "!.claude",
      "!.codex",
      "!.pi",
      "!.opencode",
      "!.cursor",
      "!**/.context",
      "!packages/agent-edit/demo/**/*.html",
      "!packages/database/src/migrations/meta/*_snapshot.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/turn-graph.js"],
                "message": "The turn graph includes the turns that left the conversation: writer messages a hand-back took out of the chat, and failed attempts the writer retried or the chat moved past. Read turns and blocks through TurnRepository and BlockRepository, which return the conversation. Only the graph modules listed in biome.json may import turn-graph."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/server/server/domains/threads/ports/**",
        "apps/server/server/domains/threads/adapters/drizzle/turn-repository.ts",
        "apps/server/server/domains/threads/adapters/in-memory/repositories.ts",
        "apps/server/server/domains/threads/domain/thread-conversation-context.ts",
        "apps/server/server/domains/threads/domain/transcript-page.ts",
        "apps/server/server/domains/threads/thread-snapshot.ts",
        "apps/server/server/domains/runtime/loop/orchestrator.ts",
        "apps/server/server/domains/runtime/loop/latest-row.ts",
        "apps/server/server/domains/runtime/loop/forget-failed-attempt.ts",
        "apps/server/server/domains/runtime/loop/run-session.ts",
        "apps/server/server/domains/runtime/loop/inbox-context.ts",
        "apps/server/server/domains/runtime/handoff/brief-service.ts",
        "apps/server/server/domains/runtime/adapters/runtime-delivery.ts",
        "apps/server/server/domains/runtime/spawn/thread-ls.ts",
        "apps/server/server/domains/runtime/spawn/resolve-readable-thread.ts",
        "**/*.test.ts",
        "**/*-contract.ts",
        "**/__tests__/**",
        "**/__conformance__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
