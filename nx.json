{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedConfiguration"],
    "sharedConfiguration": [
      "{workspaceRoot}/*.{json,yaml,yml,js,cjs,mjs,ts,cts,mts}",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/packages/tsconfig*.json",
      "{workspaceRoot}/patches/**/*",
      "{workspaceRoot}/tools/ci/run-nx-target.mjs"
    ],
    "production": ["default", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/**/*.spec.ts"]
  },
  "targetDefaults": {
    "typecheck": {
      "inputs": ["default", "^default"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^default"],
      "cache": true
    }
  },
  "analytics": false
}
